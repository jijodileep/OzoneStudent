{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=schoolsaas_dev;User=root;Password=password",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Tenancy": {
    "AllowHeaderTenantId": true,
    "AllowHeaderTenantSlug": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstancePrefix": "schoolsaas:dev"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "Exchange": "schoolsaas.events"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxRetries": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
