{
  "App": {
    "PublicBaseUrl": "http://localhost:5275"
  },
  "Jwt": {
    "Issuer": "SchoolSaaS",
    "Audience": "SchoolSaaS",
    "SecretKey": "REPLACE_WITH_32_CHAR_MINIMUM_SECRET_KEY",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "Platform": "Server=localhost;Port=3306;Database=schoolsaas_platform;User=root;Password=REPLACE_ME",
    "Provisioning": "Server=localhost;Port=3306;User=root;Password=REPLACE_ME",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Tenancy": {
    "DatabaseNamePrefix": "ss_t_",
    "DefaultDbServer": "localhost",
    "DefaultDbPort": 3306,
    "DefaultDbUser": "root",
    "DefaultDbPassword": "REPLACE_ME",
    "ProvisioningDbUser": null,
    "ProvisioningDbPassword": null
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstancePrefix": "schoolsaas"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "Exchange": "schoolsaas.events"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxRetries": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
